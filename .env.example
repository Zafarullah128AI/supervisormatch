# SupervisorMatch — Gemini API key (local setup)
# 1. Rename this file to .env
# 2. Replace the value below with your own key from https://aistudio.google.com
#    (Get API key -> Create API key). The .env file is git-ignored and is
#    never included in the zip, so your key stays private.
GEMINI_API_KEY=paste-your-key-here
